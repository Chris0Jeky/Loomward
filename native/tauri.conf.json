{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Loomward",
  "version": "0.1.0",
  "identifier": "dev.loomward.desktop",
  "build": { "frontendDist": "../app/dist" },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      { "label": "main", "create": false, "title": "Loomward", "width": 1440, "height": 1000, "minWidth": 720, "minHeight": 560 }
    ],
    "security": {
      "capabilities": ["main-window"],
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": { "pubkey": "", "requireSignedVersion": true, "windows": { "installMode": "passive" } }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/icon.ico"],
    "publisher": "Loomward contributors",
    "shortDescription": "Local-first Windows workspace, storage and resource companion (unsigned preview)",
    "licenseFile": "../LICENSE",
    "externalBin": ["binaries/loomward-broker", "binaries/loomward-mcp"],
    "resources": { "../contracts/v3/examples": "contracts/v3/examples" },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
