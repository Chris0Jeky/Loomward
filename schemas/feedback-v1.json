{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loomward feedback-v1",
  "description": "Human and teacher provenance remain distinct. Demo data requires an explicit training opt-in. Retraction is not deletion of history.",
  "type": "object",
  "required": [
    "mode",
    "events"
  ],
  "properties": {
    "mode": {
      "enum": [
        "observed",
        "imported",
        "demo"
      ]
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "item_id",
          "source",
          "revision",
          "label",
          "features"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source": {
            "enum": [
              "human",
              "teacher"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          },
          "label": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9 _-]{0,63}$"
          },
          "features": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 256
              },
              "extension": {
                "type": "string",
                "maxLength": 32
              },
              "context": {
                "type": "string",
                "maxLength": 512
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          },
          "retracted": {
            "type": "boolean"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "recorded_at": {
            "type": "string"
          }
        }
      }
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9 _-]{0,63}$"
      }
    }
  }
}
