{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Loomward inventory-v1",
  "description": "Read-only observation envelope. Extra metadata is permitted but is never authority. Native and Python stat identities are not interchangeable. Runtime limits may be stricter.",
  "type": "object",
  "required": [
    "schema_version",
    "mode",
    "root",
    "files",
    "summary",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "observed",
        "demo",
        "imported"
      ]
    },
    "root": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "maxItems": 200000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "relative_path",
          "name",
          "extension",
          "size_bytes",
          "allocated_bytes",
          "flags",
          "identity_quality"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "relative_path": {
            "type": "string",
            "maxLength": 32768
          },
          "name": {
            "type": "string",
            "maxLength": 32768
          },
          "extension": {
            "type": "string",
            "maxLength": 32768
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "allocated_bytes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "flags": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 64
            }
          },
          "identity_quality": {
            "type": "string"
          },
          "mtime_ns": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "ctime_ns": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "file_count",
        "logical_bytes"
      ],
      "properties": {
        "file_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "logical_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allocated_bytes_known_sum": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "allocated_unknown_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "limit_hit",
        "error_count",
        "skipped_count"
      ],
      "properties": {
        "limit_hit": {
          "type": "boolean"
        },
        "error_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skipped_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "complete_under_policy": {
          "type": "boolean"
        },
        "unqualified_complete": {
          "type": "boolean"
        }
      }
    }
  }
}
